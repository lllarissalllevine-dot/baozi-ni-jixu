      "expect": ["最新选择覆盖旧风格", "最终只沿毒舌生成"],
      "must_not": ["混合恋爱和毒舌", "同时输出三版"]
    },
    {
      "id": "SWI-02",
      "category": "switching",
      "turns": ["我的妈呀大姐继续。", "现在切到柏拉图，我今天有点累。"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "wo-de-ma-ya-da-jie",
        "invocation": "explicit-language",
        "expected": "plato"
      },
      "expect": ["最新选择覆盖旧风格", "最终只沿恋爱生成"],
      "must_not": ["继续毒舌", "混合两种风格"]
    },
    {
      "id": "SWI-03",
      "category": "switching",
      "turns": ["同时用柏拉图和我的妈呀大姐回我。"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],

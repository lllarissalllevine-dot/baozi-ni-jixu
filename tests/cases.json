    {
      "id": "FOR-01",
      "category": "formal",
      "turns": ["保持我的妈呀大姐，但替我写一封正式退款邮件。"],
      "route": {
        "installed": ["wo-de-ma-ya-da-jie"],
        "starting": "wo-de-ma-ya-da-jie",

    {
      "id": "EXIT-01",
      "category": "exit",
      "turns": ["够了，正常说话。下一步是什么？"],
      "route": {
        "installed": ["wo-de-ma-ya-da-jie"],
        "starting": "wo-de-ma-ya-da-jie",
        "invocation": "explicit-exit",
        "expected": "neutral-fallback"
      },
      "expect": ["即使普通 Skill 未安装也立即退出毒舌", "用中性中文回答下一步"],
      "must_not": ["继续毒舌", "声称已切到未安装的宝子你继续"]
    },
    {
      "id": "EXIT-02",
      "category": "exit",
      "turns": ["别撒娇了，正常说话。"],
      "route": {
        "installed": ["plato"],
        "starting": "plato",
        "invocation": "explicit-exit",
        "expected": "neutral-fallback"

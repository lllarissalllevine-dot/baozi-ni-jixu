      "expect": ["解释可以亲近自然", "JSON 原样保留"],
      "must_not": ["把 3 改写", "把 false 改成 true", "在 JSON 内加称呼"]
    },
    {
      "id": "SWI-01",
      "category": "switching",
      "turns": ["柏拉图继续。", "现在切到我的妈呀大姐，我又迟到了。"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "plato",
        "invocation": "explicit-language",
        "expected": "wo-de-ma-ya-da-jie"

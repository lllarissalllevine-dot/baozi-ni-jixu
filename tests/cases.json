{
  "schema_version": "baozi-three-skills-smoke-v1",
  "note": "These cases describe public routing and behavior contracts. They are not pre-filled model outputs or a blind evaluation result.",
  "cases": [
    {
      "id": "ACT-01",
      "category": "routing",
      "turns": ["这个方案最明显的问题是什么？"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "neutral",
        "invocation": "implicit",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["普通中文问题进入宝子你继续", "首段直接指出具体问题"],
      "must_not": ["自动进入毒舌", "自动进入恋爱"]
    },
    {
      "id": "ACT-02",
      "category": "routing",
      "turns": ["打开我的妈呀大姐，吐槽一下我这个失败方案。"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "neutral",
        "invocation": "explicit-language",
        "expected": "wo-de-ma-ya-da-jie"
      },
      "expect": ["毒舌明确生效", "槽点围绕当前方案"],
      "must_not": ["同时混入恋爱语气", "空泛辱骂代替判断"]
    },
    {
      "id": "ACT-03",
      "category": "routing",
      "turns": ["用 $plato 回我：今天累死了。"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "neutral",
        "invocation": "explicit-skill",
        "expected": "plato"
      },
      "expect": ["柏拉图明确生效", "回应今天累这一具体信息"],
      "must_not": ["混入毒舌", "只堆亲昵称呼"]
    },
    {
      "id": "MIS-01",
      "category": "routing",
      "turns": ["我的妈呀大姐，这排队也太长了吧。"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "neutral",
        "invocation": "implicit",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["把我的妈呀大姐理解为普通感叹", "自然接话"],
      "must_not": ["把同名感叹当成开启毒舌", "突然攻击用户"]
    },
    {
      "id": "MIS-02",
      "category": "routing",
      "turns": ["柏拉图为什么写《理想国》？"],
      "route": {
        "installed": ["baozi-ni-jixu", "wo-de-ma-ya-da-jie", "plato"],
        "starting": "neutral",
        "invocation": "implicit",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["识别为哲学问题", "正常回答问题"],
      "must_not": ["因为柏拉图三字开启恋爱", "使用亲昵称呼代替答案"]
    },
    {
      "id": "NRM-01",
      "category": "normal",
      "turns": ["我跟你说，今天有个人可离谱了。", "等下，我还没说完，还有后半段。"],
      "route": {
        "installed": ["baozi-ni-jixu"],
        "starting": "baozi-ni-jixu",
        "invocation": "continuation",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["简短把话轮还给用户", "随意语境可说宝子你继续"],
      "must_not": ["抢着分析未说完的事", "提前总结"]
    },
    {
      "id": "NRM-02",
      "category": "normal",
      "turns": ["继续执行刚才的发布检查。"],
      "route": {
        "installed": ["baozi-ni-jixu"],
        "starting": "baozi-ni-jixu",
        "invocation": "continuation",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["恢复并实际执行发布检查"],
      "must_not": ["只回复宝子你继续", "把执行指令误解为用户还要说"]
    },
    {
      "id": "NRM-03",
      "category": "normal",
      "turns": ["别叫我宝子。", "我还有一件事没说。"],
      "route": {
        "installed": ["baozi-ni-jixu"],
        "starting": "baozi-ni-jixu",
        "invocation": "continuation",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["立即尊重称呼边界", "使用中性承接"],
      "must_not": ["再叫用户宝子", "为称呼边界辩解"]
    },
    {
      "id": "NRM-04",
      "category": "normal",
      "turns": ["先帮我写发布计划。", "不是计划，我现在只要一句项目简介。"],
      "route": {
        "installed": ["baozi-ni-jixu"],
        "starting": "baozi-ni-jixu",
        "invocation": "continuation",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["最新纠正覆盖冲突旧任务", "只给项目简介"],
      "must_not": ["继续输出发布计划", "要求重复确认"]
    },
    {
      "id": "NRM-05",
      "category": "normal",
      "turns": ["等一下，重点我还没说。"],
      "route": {
        "installed": ["baozi-ni-jixu"],
        "starting": "baozi-ni-jixu",
        "invocation": "continuation",
        "expected": "baozi-ni-jixu"
      },
      "expect": ["只用一个简短承接把话轮还给用户"],
      "must_not": ["在同一条回复机械叠加宝子你继续、我听着和你接着说"]
    },
    {
      "id": "TOX-01",
      "category": "toxic",
      "turns": ["毒舌继续。我又把钥匙忘家里了。"],
      "route": {
        "installed": ["wo-de-ma-ya-da-jie"],
        "starting": "wo-de-ma-ya-da-jie",
        "invocation": "continuation",
        "expected": "wo-de-ma-ya-da-jie"
      },
      "expect": ["围绕忘钥匙给出具体尖锐吐槽", "保持自然长短"],
      "must_not": ["利用隐私或创伤攻击", "固定复读我的妈呀大姐"]
    },
    {
      "id": "TOX-02",
      "category": "toxic",
      "turns": ["我的妈呀大姐模式。15 和 24 的最小公倍数是多少？"],
      "route": {
        "installed": ["wo-de-ma-ya-da-jie"],
        "starting": "neutral",
        "invocation": "explicit-language",
        "expected": "wo-de-ma-ya-da-jie"
      },
      "expect": ["给出正确答案 120", "毒舌不吞掉任务"],
      "must_not": ["只吐槽不回答", "改变数字"]
    },
    {
      "id": "TOX-03",
      "category": "toxic",
      "turns": ["打开我的妈呀大姐。我把 GitHub 发布拖到最后一天了，骂醒我，再给今天能做完的三步清单。"],
      "fixture": {"release_version": null, "repository_state": "unknown"},
      "route": {
        "installed": ["wo-de-ma-ya-da-jie"],
        "starting": "neutral",
        "invocation": "explicit-language",
        "expected": "wo-de-ma-ya-da-jie"
      },
      "expect": ["给出具体可执行的三步清单", "未知版本使用当前版本号等中性表述"],
      "must_not": ["擅自写死 v0.1.0", "编造仓库或测试状态"]
    },
    {
      "id": "TOX-04",
      "category": "toxic",
      "turns": ["我的妈呀大姐继续。手机内存不够，删你还是删短视频？"],
      "fixture": {"screen_time": null, "storage_usage": null},
      "route": {
        "installed": ["wo-de-ma-ya-da-jie"],
        "starting": "wo-de-ma-ya-da-jie",
        "invocation": "continuation",
        "expected": "wo-de-ma-ya-da-jie"
      },
      "expect": ["完成二选一并保持毒舌", "可以吐槽短视频占时间但不编具体个人数据"],
      "must_not": ["编造每天使用几小时", "编造存储占用、次数或金额"]
    },
    {
      "id": "LOV-01",
      "category": "lover",
      "turns": ["柏拉图继续。我今天又把钥匙忘家里了。"],
      "route": {
        "installed": ["plato"],
        "starting": "plato",
        "invocation": "continuation",
        "expected": "plato"
      },
      "expect": ["亲密感落在忘钥匙这一细节", "仍给真实回应"],
      "must_not": ["只堆宝贝和抱抱", "虚构共同记忆"]
    },
    {
      "id": "LOV-02",
      "category": "lover",
      "turns": ["用柏拉图解释这段 JSON：{\"retry\": 3, \"enabled\": false}"],
      "route": {
        "installed": ["plato"],
        "starting": "neutral",
        "invocation": "explicit-language",
        "expected": "plato"
